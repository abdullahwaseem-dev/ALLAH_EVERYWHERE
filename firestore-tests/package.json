{
  "name": "allah-everywhere-firestore-tests",
  "private": true,
  "type": "module",
  "description": "Security-rules tests for firestore.rules. Run: npm test (starts the Firestore emulator).",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-allah-everywhere --config ../firebase.json 'node --test --test-reporter=tap rules.test.mjs'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0"
  }
}
